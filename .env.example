# Apex Books Frontend env (copy to .env.local for dev)

# Backend base URL (apex-flow-labs Next.js project)
NEXT_PUBLIC_BACKEND_URL=https://www.apexflowlabs.com

# This site's public URL
NEXT_PUBLIC_SITE_URL=https://books.apexflowlabs.com

# Server-side bearer for the backend /api/v1/* surface
APEX_API_BEARER=replace-with-shared-secret

# Supabase (same project as the rest of the Apex empire — auth cookie is
# scoped to .apexflowlabs.com so SSO works across every brand subdomain).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — powers the Books Concierge chat widget. Server-side only,
# never exposed to the browser. Get a key at platform.openai.com.
# Without this set, the concierge falls back to a static "briefly
# offline" message + 3 starting links.
OPENAI_API_KEY=

# Analytics (load only after cookie consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL=
NEXT_PUBLIC_CLARITY_ID=
